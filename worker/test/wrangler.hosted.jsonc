{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ansa-hosted-test",
  "main": "probe-worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ANSA", "class_name": "ProbeStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeStore"] }],
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "ansa-test-attachments" }],
  "services": [{ "binding": "CONTROL", "service": "ansa-hosted-test", "entrypoint": "ControlPlane" }],
  "vars": { "ANSA_HOSTED": "1", "APP_BLOCKED_HOST_SUFFIX": "hosted.test" }
}
