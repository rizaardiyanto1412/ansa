{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ansa-isolation-test",
  "main": "probe-worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [{ "name": "ANSA", "class_name": "ProbeStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ProbeStore"] }],
  "env": {
    "r2": {
      "durable_objects": {
        "bindings": [{ "name": "ANSA", "class_name": "ProbeStore" }]
      },
      "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "ansa-test-attachments" }]
    }
  }
}
